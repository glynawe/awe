begin
   string(5) procedure hello; "Hello";
   string(5) procedure world; "World";

   assert("abc" = "abc");
   assert("bce" > "abc");
   assert("abc" < "bce");

   assert("abc" ~= "abcd");
   assert("abcd" > "abc");
   assert("abc"  < "abcd");


   comment Spaces at the ends of strings do not count in comparisions;

   assert("abc"  = "abc ");
   assert("bce " > "abc");
   assert("abc " < "bce");
   assert("bce"  > "abc ");
   assert("abc"  < "bce ");

   assert("abc "  = "abc  ");
   assert("bce  " > "abc ");
   assert("abc  " < "bce ");
   assert("bce "  > "abc  ");
   assert("abc "  < "bce  ");

   comment a test of the dual string buffers for function result comparison;

   assert(~ (hello = world));
   assert(hello ~= world);
   assert(~ (hello > world));
   assert(hello < world);
end.